{
  "name": "mini-vtt",
  "version": "1.4.0",
  "description": "Lightweight two-screen map display for tabletop RPGs: a DM control window with fog of war and a separate player screen.",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run test:app",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "npm run test:build && electron scripts/test-library.mjs",
    "test:build": "esbuild electron/library.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-electron/library.test.mjs --log-level=warning && esbuild src/lib/grid.ts src/lib/areas.ts src/lib/rooms.ts src/lib/rect.ts src/lib/geometry.ts src/lib/shortcuts.ts src/lib/killScreen.ts src/lib/video.ts electron/delayedSave.ts --bundle --platform=node --format=esm --outdir=dist-electron --entry-names=[name].test --out-extension:.js=.mjs --log-level=warning",
    "test:app": "vite build && electron scripts/test-app.mjs",
    "memory": "vite build && electron scripts/memory-report.mjs",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "keywords": [
    "vtt",
    "tabletop",
    "rpg",
    "dnd",
    "fog-of-war",
    "battle-map",
    "electron",
    "react"
  ],
  "author": "Paertan85",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.2.1",
    "ajv": "^8.20.0",
    "electron": "^45.2.3",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "lucide-react": "^0.475.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-electron": "^1.2.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "build": {
    "appId": "com.minivtt.app",
    "productName": "Mini VTT",
    "afterPack": "scripts/patch-icon.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png",
      "!dist-electron/*.test.mjs"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "sign": null,
      "signAndEditExecutable": false
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.games",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Game",
      "synopsis": "A virtual tabletop for a TV or monitor on the table",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "forceCodeSigning": false,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Paertan85/mini_vtt.git"
  },
  "allowScripts": {
    "esbuild": true
  }
}
